{
  "ERB tag": {
    "prefix": "e",
    "body": "<% $1 %>",
    "description": "ERB tag"
  },
  "ERB output tag": {
    "prefix": "ee",
    "body": "<%= $1 %>",
    "description": "ERB output tag"
  },
  "ERB comment": {
    "prefix": "#",
    "body": "<%# $1 %>",
    "description": "ERB comment"
  },
  "form_with": {
    "prefix": "form",
    "body": ["<%= form_with model: $1 do |f| %>", "\t$0", "<% end %>"]
  },
  "link_to": {
    "prefix": "link",
    "body": "<%= link_to \"$1\", $2 %>"
  },
  "if": {
    "prefix": "if",
    "body": ["<% if $1 %>", "\t$0", "<% end %>"]
  },
  "each": {
    "prefix": "each",
    "body": ["<% $1.each do |$2| %>", "\t$0", "<% end %>"]
  }
}
